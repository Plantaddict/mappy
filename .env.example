DATABASE_URL="file:./dev.db"
# 32+ random characters; used to sign session cookies and download links
AUTH_SECRET="change-me-to-a-long-random-string"
# Public URL of this deployment (used in webhooks and download links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Where uploaded print files are stored (absolute or relative to project root)
FILES_DIR="./data/files"
# Vector tiles (OpenFreeMap is keyless and free; self-host for production scale)
NEXT_PUBLIC_TILES_URL="https://tiles.openfreemap.org/planet"
# Geocoder (Photon public instance is for development; self-host or use a provider in production)
GEOCODER_URL="https://photon.komoot.io/api/"
